# Azure AD / Entra ID Config para ms-rutaexpress-bff
# Microsoft Entra ID: tenant que emite los tokens y audiencias aceptadas (issue #95).
# Ambas son obligatorias: el BFF no arranca sin ellas.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_API_AUDIENCIAS=api://00000000-0000-0000-0000-000000000000
AZURE_BACKEND_CLIENT_ID=xxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
